# Copia este archivo como .env (el .env real NO se sube a GitHub)

# ---- Docker: MySQL ----
MYSQL_ROOT_PASSWORD=cambia-esta-root-password
MYSQL_DATABASE=gamevault
MYSQL_USER=gamevault_user
MYSQL_PASSWORD=cambia-esta-password

# ---- Docker: Django ----
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True

# ---- Docker: React (Vite) ----
VITE_BASE_API_URL=http://localhost:8000
VITE_LOCAL_STORAGE_ITEM_NAME=TOKEN
VITE_GAMES_API_URL=/freetogame/games

# ---- Práctica 1 (servidor Node.js de la raíz, no se usa en Docker) ----
API_URL=https://www.freetogame.com/api/games
JWT_SECRET=cambia-esto-por-un-secreto-largo-1234567890
PORT=3000
